# plot.gpi — generates the three SVG plots referenced by the Makefile
# Run with: gnuplot plot.gpi   (needs erf_data.dat and erf_accuracy.dat already present)

set terminal svg size 900,600 background rgb 'white'

# ── erf_comparison.svg: my_erf(z) vs std::erf(z) ──────────────────────────────
set output 'erf_comparison.svg'
set title 'my\_erf(z) vs std::erf(z)'
set xlabel 'z'
set ylabel 'erf(z)'
set key left top
set grid
plot 'erf_data.dat' using 1:2 with lines lw 2 title 'my\_erf(z)', \
     'erf_data.dat' using 1:3 with points pt 6 ps 0.5 title 'std::erf(z)'

# ── erf_diff.svg: |my_erf(z) - std::erf(z)| ───────────────────────────────────
set output 'erf_diff.svg'
set title 'Difference |my\_erf(z) - std::erf(z)|'
set xlabel 'z'
set ylabel '|difference|'
set logscale y
set key off
set grid
plot 'erf_data.dat' using 1:4 with lines lw 2

# ── erf_accuracy.svg: error in erf(1) vs requested accuracy acc ──────────────
set output 'erf_accuracy.svg'
set title 'erf(1): |result - exact| vs requested acc (log-log)'
set xlabel 'acc'
set ylabel '|erf(1) - exact|'
set logscale xy
set key off
set grid
plot 'erf_accuracy.dat' using 1:2 with linespoints lw 2 pt 7 ps 0.7
