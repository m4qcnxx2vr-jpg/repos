set terminal svg size 900,600 enhanced font 'Helvetica,13'

# ── Plot 1: my_erf vs std::erf ───────────────────────────────────────────────
set output 'erf_comparison.svg'
set title 'Error Function: my\_erf vs std::erf'
set xlabel 'z'
set ylabel 'erf(z)'
set grid
set key top left
plot 'erf_data.dat' u 1:2 w lp pt 7 ps 0.5 lw 1.5 title 'my\_erf (adaptive)', \
     'erf_data.dat' u 1:3 w l  lw 2.5 dt 2       title 'std::erf'

# ── Plot 2: pointwise difference (log y) ─────────────────────────────────────
set output 'erf_diff.svg'
set title 'Pointwise |my\_erf(z) - std::erf(z)|'
set ylabel '|difference|'
set yrange [1e-8:1]
set logscale y
unset key
plot 'erf_data.dat' u 1:4 w lp pt 7 ps 0.5 lw 1.5 title '|error|'

# ── Plot 3: erf(1) accuracy vs acc (log-log) ─────────────────────────────────
set output 'erf_accuracy.svg'
set title 'erf(1) accuracy vs acc  (eps=0)'
set xlabel 'acc'
set ylabel '|erf(1) - exact|'
set logscale xy
set yrange [*:*]
set key top left
plot 'erf_accuracy.dat' u 1:2 w lp pt 7 ps 0.8 lw 1.5 title '|error|', \
     x                  w l       lw 1.5 dt 2       title 'y = acc (ideal)'
