set terminal svg background "white"
set output "convergence_dr.svg"

set title "Hydrogen ground-state energy convergence with dr"
set xlabel "dr"
set ylabel "Ground-state energy"

set grid
set key outside

exact = -0.5

plot "convergence_dr.dat" using 1:2 with linespoints title "Numerical", \
     exact with lines title "Exact E_1 = -0.5"