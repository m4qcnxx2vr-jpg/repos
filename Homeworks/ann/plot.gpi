set terminal svg background "white"
set datafile separator whitespace
set key outside
set grid

set xlabel "x"

set output "ann_fit.svg"
set ylabel "function"
set title "ANN fit"
plot "ann.tsv" using 1:2 with lines title "target g(x)", \
     "ann.tsv" using 1:3 with lines title "ANN F(x)"

set output "ann_derivative.svg"
set ylabel "first derivative"
set title "First derivative"
plot "ann.tsv" using 1:4 with lines title "exact g'(x)", \
     "ann.tsv" using 1:5 with lines title "ANN F'(x)"

set output "ann_second_derivative.svg"
set ylabel "second derivative"
set title "Second derivative"
plot "ann.tsv" using 1:6 with lines title "exact g''(x)", \
     "ann.tsv" using 1:7 with lines title "ANN F''(x)"

set output "ann_antiderivative.svg"
set ylabel "anti-derivative"
set title "ANN anti-derivative"
plot "ann.tsv" using 1:8 with lines title "ANN integral"