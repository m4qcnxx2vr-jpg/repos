set terminal pngcairo size 900,650
set output "A2_error_scaling.png"

set title "Task A2: Monte Carlo error scaling"
set xlabel "Number of sampling points N"
set ylabel "Error"

unset logscale x
unset logscale y

set grid
set key top right

# Optional: make the plot start at zero
set xrange [0:*]
set yrange [0:*]

# Reference curve proportional to 1/sqrt(N)
f(x) = 1.0 / sqrt(x)

plot \
    "circle_errors.txt" using 1:2 with linespoints title "Estimated error", \
    "circle_errors.txt" using 1:3 with points pointtype 7 title "Actual error", \
    f(x) with lines title "1/sqrt(N)"