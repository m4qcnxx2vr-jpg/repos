set terminal svg size 1200,400 enhanced
set output "orbits.svg"

set multiplot layout 1,3 title "Planetary Orbits"

set size square
set grid

set title "Circular orbit"
plot "1.txt" using 2:3 with lines lw 2 notitle

set title "Elliptical orbit"
plot "2.txt" using 2:3 with lines lw 2 notitle

set title "Relativistic precession"
plot "3.txt" using 2:3 with lines lw 2 notitle

unset multiplot