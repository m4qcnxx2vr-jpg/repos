#!/usr/bin/env gnuplot
# Convergence of E0 with respect to the ODE integrator's eps parameter
set terminal pngcairo size 900,600 font "Helvetica,12"
set output "conv_eps.png"

set title "Convergence of E_0 with ODE integrator 'eps'"
set xlabel "eps"
set ylabel "|E_0 - (-0.5)|"
set logscale x
set logscale y
set grid
set key top right

plot "conv_eps.txt" using 1:3 with linespoints lw 2 pt 7 lc rgb "#9467bd" title "error vs eps"
