#!/usr/bin/env gnuplot
# Convergence of E0 with respect to rmax
set terminal pngcairo size 900,600 font "Helvetica,12"
set output "conv_rmax.png"

set title "Convergence of E_0 with rmax"
set xlabel "rmax"
set ylabel "|E_0 - (-0.5)|"
set logscale y
set grid
set key top right

plot "conv_rmax.txt" using 1:3 with linespoints lw 2 pt 7 lc rgb "#1f77b4" title "error vs rmax"
