#!/usr/bin/env gnuplot
# Convergence of E0 with respect to rmin
set terminal pngcairo size 900,600 font "Helvetica,12"
set output "conv_rmin.png"

set title "Convergence of E_0 with rmin"
set xlabel "rmin"
set ylabel "|E_0 - (-0.5)|"
set logscale x
set logscale y
set grid
set key top right

plot "conv_rmin.txt" using 1:3 with linespoints lw 2 pt 7 lc rgb "#2ca02c" title "error vs rmin"
