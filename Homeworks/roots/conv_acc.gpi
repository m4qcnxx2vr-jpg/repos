#!/usr/bin/env gnuplot
# Convergence of E0 with respect to the ODE integrator's acc parameter
set terminal pngcairo size 900,600 font "Helvetica,12"
set output "conv_acc.png"

set title "Convergence of E_0 with ODE integrator 'acc'"
set xlabel "acc"
set ylabel "|E_0 - (-0.5)|"
set logscale x
set logscale y
set grid
set key top right

plot "conv_acc.txt" using 1:3 with linespoints lw 2 pt 7 lc rgb "#d62728" title "error vs acc"
